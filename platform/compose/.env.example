# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
KEYSMITH_SIGNER_TOKEN=change-me      # shared: keysmith accepts it, idp presents it
KEYSMITH_ADMIN_TOKEN=change-me
SESSIOND_API_TOKEN=change-me
SENTINEL_TOKEN=change-me
BRIDGE_HMAC_KEY=change-me-32-bytes-minimum-aaaaaaaa
PORTAL_TOTP_KEK=change-me            # exactly 32 bytes, base64: openssl rand -base64 32
IDP_REGISTRATION_TOKEN=              # optional: enables RFC 7591 registration
IDP_DEV_MODE=1                       # 1 = in-memory + seeded demo realm (smoke.sh needs this); 0 = postgres
